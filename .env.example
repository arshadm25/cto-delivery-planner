# Copy to .env on the trusted host only. Never commit .env.
# Never put the Redmine key or any secret in a NEXT_PUBLIC_* variable.

# Redmine (read-only service account)
REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=
REDMINE_PAGE_SIZE=100
REDMINE_REQUEST_TIMEOUT=30s

# PostgreSQL. The dev value matches deploy/compose.dev.yml.
# Review TLS (sslmode) before using anything outside a trusted local network.
DATABASE_URL=postgres://planner:planner-dev-only@localhost:5432/cto_planner?sslmode=disable

# Synchronization
SCOPE_FILE=config/scope.json
SYNC_INTERVAL=30m
SYNC_FULL_INTERVAL=24h
SYNC_OVERLAP=5m
SYNC_MAX_RETRIES=5
SYNC_CONCURRENCY=2
SYNC_TIME_ENTRIES=true
SYNC_INITIAL_FULL_IMPORT=true
WORKER_HEALTH_ADDR=:8081

LOG_LEVEL=info

# API
API_ADDR=:8080
APP_ENV=development
APP_TIMEZONE=UTC
# Browser-facing Redmine URL for issue links; defaults to REDMINE_URL.
REDMINE_PUBLIC_URL=
# Set to false only for local http.
COOKIE_SECURE=true
SESSION_TTL=12h
SYNC_STALE_AFTER=2h
