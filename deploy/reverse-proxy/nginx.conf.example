# Example for nginx on the same host. Replace the hostname and certificate
# paths with your existing ones.
server {
    listen 443 ssl http2;
    server_name planner.example.com;

    ssl_certificate     /etc/ssl/certs/planner.example.com.crt;
    ssl_certificate_key /etc/ssl/private/planner.example.com.key;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80;
    server_name planner.example.com;
    return 301 https://$host$request_uri;
}
