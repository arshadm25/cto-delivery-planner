# Copy to /etc/cto-planner/planner.env on the host:
#   sudo install -m 600 -o root -g root deploy/planner.env.example /etc/cto-planner/planner.env
# then fill in the values. Never commit the filled-in file.

REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=
# Browser-facing Redmine URL for issue links, if different.
REDMINE_PUBLIC_URL=

POSTGRES_PASSWORD=
# Must use the same password. sslmode=disable is acceptable only because
# PostgreSQL is on an internal Docker network with no published port.
DATABASE_URL=postgres://planner:CHANGE_ME@postgres:5432/cto_planner?sslmode=disable

APP_TIMEZONE=UTC
SYNC_INTERVAL=30m
SYNC_FULL_INTERVAL=24h
SYNC_OVERLAP=5m
SYNC_STALE_AFTER=2h
SYNC_TIME_ENTRIES=true
SNAPSHOT_RETENTION_DAYS=730
SESSION_TTL=12h
LOG_LEVEL=info
